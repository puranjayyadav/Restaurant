// ----- FIREBASE SERVICE -----
// (In your project, move this to its own file, e.g., firebase_service.dart)
class FirebaseService {
  // Create a session document in the "sessions" collection and return its ID.
  Future<String> createSession(String uid, String startAddress) async {
    DocumentReference docRef =
        await FirebaseFirestore.instance.collection('sessions').add({
      'uid': uid,
      'startAddress': startAddress,
      'sessionDate': FieldValue.serverTimestamp(),
      // Additional session fields can be added here.
    });
    return docRef.id;
  }

  // Save establishments as documents in the "establishments" subcollection of the session.
  Future<void> saveEstablishments(
      String sessionId, List<dynamic> establishments) async {
    CollectionReference subCol = FirebaseFirestore.instance
        .collection('sessions')
        .doc(sessionId)
        .collection('establishments');
    for (var est in establishments) {
      await subCol.add(est);
    }
  }
}

// ----- TRIP SESSION MODEL -----
class TripSession {
  final String sessionId;
  final String startAddress;
  final String endAddress;
  final DateTime sessionDate;

  TripSession({
    required this.sessionId,
    required this.startAddress,
    required this.endAddress,
    required this.sessionDate,
  });

  factory TripSession.fromDocument(DocumentSnapshot doc) {
    final data = doc.data() as Map<String, dynamic>;
    return TripSession(
      sessionId: doc.id,
      startAddress: data['startAddress'] ?? '',
      endAddress: data['endAddress'] ?? '',
      sessionDate: (data['sessionDate'] as Timestamp).toDate(),
    );
  }
}

