/// ----- TRIPS SCREEN ----- ///
class TripsScreen extends StatefulWidget {
  const TripsScreen({Key? key}) : super(key: key);
  @override
  _TripsScreenState createState() => _TripsScreenState();
}

class _TripsScreenState extends State<TripsScreen> {
  bool isLoading = true;
  List<TripSession> sessions = [];
  @override
  void initState() {
    super.initState();
    fetchSessions();
  }
  Future<void> fetchSessions() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user == null) {
      setState(() {
        isLoading = false;
      });
      return;
    }
    try {
      final querySnapshot = await FirebaseFirestore.instance
          .collection('sessions')
          .where('uid', isEqualTo: user.uid)
          .orderBy('sessionDate', descending: true)
          .get();
      final fetchedSessions = querySnapshot.docs
          .map((doc) => TripSession.fromDocument(doc))
          .toList();
      setState(() {
        sessions = fetchedSessions;
        isLoading = false;
      });
    } catch (e) {
      print("Error fetching sessions: $e");
      setState(() {
        isLoading = false;
      });
    }
  }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text("Your Trips")),
      body: isLoading
          ? const Center(child: CircularProgressIndicator())
          : sessions.isEmpty
              ? const Center(child: Text("No trips recorded yet."))
              : ListView.builder(
                  itemCount: sessions.length,
                  itemBuilder: (context, index) {
                    final session = sessions[index];
                    return ListTile(
                      title: Text("Session: ${session.sessionId}"),
                      subtitle: Text(
                          "Start: ${session.startAddress}\nEnd: ${session.endAddress}"),
                      trailing:
                          Text(DateFormat.yMMMd().format(session.sessionDate)),
                      onTap: () {
                        Navigator.push(
                          context,
                          MaterialPageRoute(
                            builder: (context) => TripDetailsScreen(sessionId: session.sessionId),
                          ),
                        );
                      },
                    );
                  },
                ),
    );
  }
}

/// ----- TRIP DETAILS SCREEN ----- ///
class TripDetailsScreen extends StatelessWidget {
  final String sessionId;
  const TripDetailsScreen({Key? key, required this.sessionId}) : super(key: key);
  @override
  Widget build(BuildContext context) {
    final establishmentsStream = FirebaseFirestore.instance
        .collection('sessions')
        .doc(sessionId)
        .collection('establishments')
        .snapshots();
    return Scaffold(
      appBar: AppBar(title: const Text("Trip Details")),
      body: StreamBuilder<QuerySnapshot>(
        stream: establishmentsStream,
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Center(child: CircularProgressIndicator());
          }
          if (snapshot.hasError) {
            return Center(child: Text("Error: ${snapshot.error}"));
          }
          final docs = snapshot.data?.docs ?? [];
          if (docs.isEmpty) {
            return const Center(child: Text("No establishments found for this trip."));
          }
          return ListView(
            children: docs.map((doc) {
              final data = doc.data() as Map<String, dynamic>;
              return ListTile(
                title: Text(data['name'] ?? 'No Name'),
                subtitle: Text(data['address'] ?? 'No Address'),
              );
            }).toList(),
          );
        },
      ),
    );
  }
}

